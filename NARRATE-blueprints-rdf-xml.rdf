  <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#DisruptionEvent">
    <rdfs:comment>DisruptionEvent represents a type of DerivedEvent that indicates a significant disturbance or interruption affecting operations, resources, or supply chain continuity. It captures events with potential high impact requiring mitigation or adaptation.</rdfs:comment>
    <j.0:blueprintClass>EventBlueprint</j.0:blueprintClass>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#DerivedEvent"/>
