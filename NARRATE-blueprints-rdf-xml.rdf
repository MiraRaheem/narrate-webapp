    <rdfs:domain rdf:resource="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#Sensor"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#recoveryPlanDescription">
    <rdfs:comment>Describes the coordinated recovery activities intended to restore affected operations and support the selected mitigation strategy.</rdfs:comment>
