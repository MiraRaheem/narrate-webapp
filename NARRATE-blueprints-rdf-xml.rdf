  <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#hasLifecycleState">
    <rdfs:comment>Represents the current state of the event within its lifecycle, capturing its progression from detection or prediction through validation and resolution.</rdfs:comment>
    <rdfs:range>
      <rdfs:Datatype>
        <owl:oneOf>
          <rdf:List>
            <rdf:rest>
              <rdf:List>
                <rdf:rest>
                  <rdf:List>
                    <rdf:rest>
                      <rdf:List>
                        <rdf:rest>
                          <rdf:List>
                            <rdf:rest>
                              <rdf:List>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                <rdf:first>Resolved</rdf:first>
                              </rdf:List>
                            </rdf:rest>
                            <rdf:first>Predicted</rdf:first>
                          </rdf:List>
                        </rdf:rest>
                        <rdf:first>Mitigated</rdf:first>
                      </rdf:List>
                    </rdf:rest>
                    <rdf:first>Detected</rdf:first>
                  </rdf:List>
                </rdf:rest>
                <rdf:first>Confirmed</rdf:first>
              </rdf:List>
            </rdf:rest>
            <rdf:first>Active</rdf:first>
          </rdf:List>
        </owl:oneOf>
      </rdfs:Datatype>
    </rdfs:range>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#Event"/>
  </owl:DatatypeProperty>
