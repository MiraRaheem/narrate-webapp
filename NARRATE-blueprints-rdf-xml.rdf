    <j.0:blueprintClass>SLAgreementBlueprint</j.0:blueprintClass>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#MaterialSupplier">
    <rdfs:comment>MaterialSupplier represents an entity responsible for supplying raw or semi-finished materials to manufacturers or component suppliers within the supply chain. It plays a key role in ensuring material availability, quality compliance, and alignment with sustainability and SLA requirements.</rdfs:comment>
    <j.0:blueprintClass>SupplierBlueprint</j.0:blueprintClass>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#Supplier"/>
