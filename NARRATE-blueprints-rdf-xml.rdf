  <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#disruptionTypeName">
    <rdfs:comment>IIdentifies the operational category of a disruption. Allowed values: Supply (material or supplier availability problems); Production (manufacturing process interruptions or bottlenecks); Equipment (machine failures or equipment unavailability); Transportation (shipment, delivery, or logistics disruptions); Quality (product or material quality problems); Other (disruptions not covered by the defined categories).</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#DisruptionType"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#hasWaterUsagePerYear">
    <rdfs:comment>Water usage (m³/year)</rdfs:comment>
    <rdfs:comment>Annual water consumption (m³/year).</rdfs:comment>
    <j.0:displayOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal"
    >23</j.0:displayOrder>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#SupplierSustainability"/>
  </owl:DatatypeProperty>
