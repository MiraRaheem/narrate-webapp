    <rdfs:comment>Specialization of KPI focusing on environmental sustainability metrics.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#KPI"/>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#Customer">
    <j.0:blueprintClass>ProductBlueprint</j.0:blueprintClass>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"
        >1</owl:maxQualifiedCardinality>
        <owl:onProperty>
          <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#hasCustomerRating"/>
        </owl:onProperty>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:comment>If you later model loyalty, behavior, or segmentation, Customer can be subclassed into RetailCustomer, CorporateCustomer, etc.

hasSustainabilityPreference can be used to track and prioritize eco-conscious customers, and recommend green delivery methods.</rdfs:comment>
    <rdfs:comment>Represents the entity (person or organization) that receives products or goods — typically the endpoint of your supply chain.</rdfs:comment>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"
        >1</owl:qualifiedCardinality>
        <owl:onProperty>
          <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#hasCustomerID"/>
        </owl:onProperty>
      </owl:Restriction>
    </rdfs:subClassOf>
    <j.0:blueprintClass>SLAgreementBlueprint</j.0:blueprintClass>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"
        >1</owl:maxQualifiedCardinality>
        <owl:onProperty>
          <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#hasCustomerType"/>
        </owl:onProperty>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
