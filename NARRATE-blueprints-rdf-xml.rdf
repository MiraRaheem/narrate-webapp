<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:j.0="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31/"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#">
  <owl:Ontology rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31"/>
  <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#ConditionSensorObservation">
    <j.0:blueprintClass>SensorBlueprint</j.0:blueprintClass>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#SensorObservation"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#MaterialSpecification">
    <j.0:blueprintClass>ProductBlueprint</j.0:blueprintClass>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#ProductSpecification"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#CarrierSustainability">
    <j.0:blueprintClass>SustainabilityBlueprint</j.0:blueprintClass>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#LogisticsSustainability"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#OperationSustainability">
    <rdfs:comment>“Abstract class – do not instantiate directly.”</rdfs:comment>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#Sustainability"/>
    </rdfs:subClassOf>
    <owl:equivalentClass>
      <owl:Class>
        <owl:unionOf rdf:parseType="Collection">
          <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#CarrierSustainability"/>
          <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#LogisticsSustainability"/>
          <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#ShipmentSustainability"/>
          <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#SupplierSustainability"/>
          <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#WarehouseSustainability"/>
        </owl:unionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#TransportationDisruptionEvent">
    <rdfs:comment>Represents an actionable event indicating a disruption in transportation that impacts logistics operations and requires mitigation actions.</rdfs:comment>
    <j.0:blueprintClass>EventBlueprint</j.0:blueprintClass>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#LogisticsEvent"/>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#DisruptionEvent"/>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#ActionableEvent"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#Shipment">
    <rdfs:comment>Sustainability Analytics Ideas:
Use hasCarbonEstimateKG, hasTransportMode, and hasDistanceKM to later compute emissions, optimize routes, or prioritize low-carbon transport.

Contracts can also be filtered by hasSustainabilityClause = true for eco-focused dashboards.</rdfs:comment>
    <rdfs:comment>Represents a shipment event involving transportation of products or batches.</rdfs:comment>
    <j.0:blueprintClass>SensorBlueprint</j.0:blueprintClass>
    <j.0:blueprintClass>LogisticsBlueprint</j.0:blueprintClass>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#EnvironmentalParameter">
    <j.0:blueprintClass>SensorBlueprint</j.0:blueprintClass>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#MeasuredParameter"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#ProductComponent">
    <rdfs:comment>This class represented manufactured components (semi-final products) towards the final product</rdfs:comment>
    <j.0:blueprintClass>SustainabilityBlueprint</j.0:blueprintClass>
    <j.0:blueprintClass>ProductBlueprint</j.0:blueprintClass>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#Location">
    <j.0:blueprintClass>WarehousingBlueprint</j.0:blueprintClass>
    <j.0:blueprintClass>SupplierBlueprint</j.0:blueprintClass>
    <j.0:blueprintClass>ProductionPlanBlueprint</j.0:blueprintClass>
    <j.0:blueprintClass>ProductBlueprint</j.0:blueprintClass>
    <j.0:blueprintClass>LogisticsBlueprint</j.0:blueprintClass>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#Carrier">
    <rdfs:comment>Analytics &amp; Sustainability Applications
Total CO₂ per shipment = hasDistanceKM × hasAvgCO2PerKM (from Carrier)

Rank partners by sustainability certification, average emissions, or preferred eco-friendly transport modes

Use hasFuelType and hasCarrierType to compare emission profiles across modes</rdfs:comment>
    <rdfs:comment>A Carrier represents the actual vehicle or transport unit (truck, ship, aircraft, etc.) used in delivering shipments.

In real-world systems, one LogisticsPartner may operate multiple Carriers.</rdfs:comment>
    <j.0:blueprintClass>LogisticsBlueprint</j.0:blueprintClass>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#ObservationEvent">
    <rdfs:comment>ObservationEvent represents an event that encapsulates a recorded observation and links it to the underlying measurement data without duplicating it.</rdfs:comment>
    <j.0:blueprintClass>EventBlueprint</j.0:blueprintClass>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#Event"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#ShipmentSustainability">
    <j.0:blueprintClass>SustainabilityBlueprint</j.0:blueprintClass>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#OperationSustainability"/>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#KPIEvaluation">
    <rdfs:comment>Represents a specific execution instance of a KPI computation. It captures the evaluation context, inputs, timing, and resulting value of a KPI when triggered by an event or request.
It enables traceability, temporal tracking, and auditability of KPI calculations within the BMS.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#Material">
    <j.0:blueprintClass>SustainabilityBlueprint</j.0:blueprintClass>
    <j.0:blueprintClass>ProductBlueprint</j.0:blueprintClass>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#ProcessExecution">
    <rdfs:comment>This class represents a single execution or run of a production process — capturing real-time events, input/output, durations, and results.</rdfs:comment>
    <rdfs:comment>Design Rationale:
ProductionProcess	The definition or model of a process (e.g., “Injection Molding”)
ProcessExecution	A real-world occurrence (e.g., “Injection Molding run on April 21, 2025 at 9:00 AM”)</rdfs:comment>
    <j.0:blueprintClass>ProductionPlanBlueprint</j.0:blueprintClass>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#Machine">
    <rdfs:comment>The Machine class represents any equipment or device used during production processes such as assembly, inspection, or packaging. This class can be extended with subclasses (e.g., ConveyorBelt, 3DPrinter, PackagingMachine) if needed later.</rdfs:comment>
    <rdfs:comment>Additional Modeling Ideas:
subclass Machine into types like AssemblyMachine, InspectionTool, PackagingUnit

Maintenance history could be modeled as a separate class (MaintenanceLog) to enable auditability.</rdfs:comment>
    <j.0:blueprintClass>SensorBlueprint</j.0:blueprintClass>
    <j.0:blueprintClass>ResourceBlueprint</j.0:blueprintClass>
    <j.0:blueprintClass>ProductionPlanBlueprint</j.0:blueprintClass>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#AnalyticalEvent">
    <rdfs:comment>AnalyticalEvent represents a type of DerivedEvent that is produced through analytical processing, such as rule evaluation, statistical analysis, or predictive modeling. It captures interpreted insights including anomalies, threshold violations, and predictions derived from one or more underlying events.</rdfs:comment>
    <j.0:blueprintClass>EventBlueprint</j.0:blueprintClass>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#DerivedEvent"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#PhysicalParameter">
    <j.0:blueprintClass>SensorBlueprint</j.0:blueprintClass>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#MeasuredParameter"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#ComponentSupplier">
    <rdfs:comment>This supplier specifically provides components (e.g., cot frames, hinges, side rails) used in product assembly. ComponentSupplier is an entity that provides pre-fabricated components or subassemblies used in the manufacturing of finished products.
It ensures timely delivery, quality assurance, and adherence to technical specifications and SLAs within the smart manufacturing network.</rdfs:comment>
    <j.0:blueprintClass>SupplierBlueprint</j.0:blueprintClass>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#Supplier"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#SensorObservation">
    <owl:equivalentClass>
      <owl:Class>
        <owl:unionOf rdf:parseType="Collection">
          <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#ConditionSensorObservation"/>
          <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#EnviroSensorObservation"/>
          <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#LogisticsSensorObservation"/>
          <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#ProductionSensorObservation"/>
        </owl:unionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#LogisticsSustainability">
    <j.0:blueprintClass>SustainabilityBlueprint</j.0:blueprintClass>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#OperationSustainability"/>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#PredictiveMaintenanceEvent">
    <rdfs:comment>Represents an actionable event indicating that maintenance should be performed based on predicted equipment conditions or degradation.</rdfs:comment>
    <j.0:blueprintClass>EventBlueprint</j.0:blueprintClass>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#MaintenanceEvent"/>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#ActionableEvent"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#WaterKPI">
    <j.0:blueprintClass>SustainabilityBlueprint</j.0:blueprintClass>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#SustainabilityKPI"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#EnviroSensorObservation">
    <j.0:blueprintClass>SensorBlueprint</j.0:blueprintClass>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#SensorObservation"/>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#LaborRole">
    <j.0:blueprintClass>ResourceBlueprint</j.0:blueprintClass>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#SupplierSustainability">
    <j.0:blueprintClass>SustainabilityBlueprint</j.0:blueprintClass>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#OperationSustainability"/>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#WorkOrder">
    <rdfs:comment>Modeling Ideas:
We can define subclasses like AssemblyOrder, InspectionOrder, or RepairOrder if you want workflow-specific types.

If a workflow engine or ERP-style system is needed, WorkOrder can serve as a controller for scheduling, tracking, and history.</rdfs:comment>
    <rdfs:comment>A WorkOrder represents a formal instruction to carry out a production operation — such as assembling a certain quantity of a product using a specific process, within a timeframe.</rdfs:comment>
    <j.0:blueprintClass>ProductionPlanBlueprint</j.0:blueprintClass>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#ProcessSustainability">
    <j.0:blueprintClass>SustainabilityBlueprint</j.0:blueprintClass>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#Sustainability"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#SupplierMetadata">
    <j.0:blueprintClass>SupplierBlueprint</j.0:blueprintClass>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#ClassMetadata"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#ProductionProcess">
    <rdfs:comment>To model actual instances of production runs,a parallel class lnamed ProcessExecution is defined to separate the process definition from runtime data.</rdfs:comment>
    <rdfs:comment>This class models a process or step in the production lifecycle, such as assembly, testing, packaging, etc. It’s central to manufacturing workflows and can be linked to products, inputs, machines, and operators.</rdfs:comment>
    <j.0:blueprintClass>SensorBlueprint</j.0:blueprintClass>
    <j.0:blueprintClass>ProductionPlanBlueprint</j.0:blueprintClass>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#WarehouseSustainability">
    <j.0:blueprintClass>SustainabilityBlueprint</j.0:blueprintClass>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#LogisticsSustainability"/>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#MeasuredParameter">
    <owl:equivalentClass>
      <owl:Class>
        <owl:unionOf rdf:parseType="Collection">
          <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#EnvironmentalParameter"/>
          <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#LogisticsParameter"/>
          <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#PhysicalParameter"/>
          <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#ProductionMetric"/>
        </owl:unionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#KPI">
    <rdfs:comment>Represents a measurable performance indicator. This class defines the generic structure shared by all KPIs</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#LogisticsEvent">
    <rdfs:comment>LogisticsEvent represents a type of DerivedEvent associated with transportation, delivery, and movement of goods within the supply chain. It captures events affecting logistics operations, timing, and coordination.</rdfs:comment>
    <j.0:blueprintClass>EventBlueprint</j.0:blueprintClass>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#DerivedEvent"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#ProductionMetric">
    <j.0:blueprintClass>SensorBlueprint</j.0:blueprintClass>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#MeasuredParameter"/>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#Warehousing">
    <rdfs:comment>Modeling Notes
We may also consider subclasses like: CentralWarehouse, RegionalWarehouse, ThirdPartyWarehouse</rdfs:comment>
    <rdfs:comment>A Warehouse represents a physical storage location used for holding raw materials, semi-finished goods, or finished products. Warehouses may be central or decentralized, and can be linked to suppliers, batches, and inventory records.</rdfs:comment>
    <j.0:blueprintClass>WarehousingBlueprint</j.0:blueprintClass>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#Formula">
    <rdfs:comment>Represents machine-interpretable KPI computation logic.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#ProductionEvent">
    <rdfs:comment>ProductionEvent represents a type of DerivedEvent that is related to production processes, operations, or resources within the manufacturing system. It captures situations affecting production performance, flow, capacity, or execution.</rdfs:comment>
    <j.0:blueprintClass>EventBlueprint</j.0:blueprintClass>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#DerivedEvent"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#DerivedEvent">
    <rdfs:comment>DerivedEvent represents an event that is inferred, aggregated, or computed from one or more observation events or data sources. It captures higher-level semantics such as threshold violations, anomalies, predictions, or correlations, and serves as the basis for decision-making and system responses within the Smart Manufacturing Network.
this is the most important class in the Event hierarchy. This is where the model moves from data representation → intelligence (CEP, reasoning, disruption, KPIs).</rdfs:comment>
    <j.0:blueprintClass>EventBlueprint</j.0:blueprintClass>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#Event"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#Factory">
    <j.0:blueprintClass>SustainabilityBlueprint</j.0:blueprintClass>
    <j.0:blueprintClass>SupplierBlueprint</j.0:blueprintClass>
    <j.0:blueprintClass>SensorBlueprint</j.0:blueprintClass>
    <j.0:blueprintClass>ProductionPlanBlueprint</j.0:blueprintClass>
    <j.0:blueprintClass>ProductBlueprint</j.0:blueprintClass>
    <j.0:blueprintClass>LogisticsBlueprint</j.0:blueprintClass>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#OutsourcedComponent">
    <j.0:blueprintClass>SustainabilityBlueprint</j.0:blueprintClass>
    <j.0:blueprintClass>ProductBlueprint</j.0:blueprintClass>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#ProductComponent"/>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#ActionableEvent">
    <rdfs:comment>ActionableEvent represents a type of DerivedEvent that requires or triggers a response, decision, or intervention within the Smart Manufacturing Network. It captures situations where system adaptation, mitigation, or optimization actions are necessary. Events important enough to trigger DTPL/BMS actions</rdfs:comment>
    <j.0:blueprintClass>EventBlueprint</j.0:blueprintClass>
