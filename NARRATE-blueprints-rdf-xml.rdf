                    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                    <rdf:first>Silver</rdf:first>
                  </rdf:List>
                </rdf:rest>
                <rdf:first>Gold</rdf:first>
              </rdf:List>
            </rdf:rest>
            <rdf:first>Basic</rdf:first>
          </rdf:List>
        </owl:oneOf>
      </rdfs:Datatype>
    </rdfs:range>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#SLAgreement"/>
