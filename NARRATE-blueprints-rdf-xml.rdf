      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#Sensor">
    <rdfs:comment>Abstract representation of a sensor within the NARRATE Digital Twin framework that monitors measurable parameters and produces observations describing the state or performance of manufacturing, logistics, or environmental entities. Specialized subclasses represent different sensor roles such as condition monitoring, production monitoring, logistics, and environmental sensing.</rdfs:comment>
    <owl:equivalentClass>
      <owl:Class>
