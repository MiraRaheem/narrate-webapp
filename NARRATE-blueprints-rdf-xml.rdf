                                        <rdf:first>WeldingMachine</rdf:first>
                                      </rdf:List>
                                    </rdf:rest>
                                    <rdf:first>Robot</rdf:first>
                                  </rdf:List>
                                </rdf:rest>
                                <rdf:first>PackagingMachine</rdf:first>
                              </rdf:List>
                            </rdf:rest>
                            <rdf:first>MixingMachine</rdf:first>
                          </rdf:List>
                        </rdf:rest>
                        <rdf:first>InspectionMachine</rdf:first>
                      </rdf:List>
                    </rdf:rest>
                    <rdf:first>CuttingMachine</rdf:first>
                  </rdf:List>
                </rdf:rest>
                <rdf:first>Conveyor</rdf:first>
              </rdf:List>
            </rdf:rest>
            <rdf:first>AssemblyMachine</rdf:first>
          </rdf:List>
        </owl:oneOf>
      </rdfs:Datatype>
    </rdfs:range>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#Machine"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#parameterID">
    <rdfs:comment>Unique identifier for the measurable parameter used to ensure traceability and consistent reference across sensors, observations, and analytics tools.</rdfs:comment>
    <j.0:displayOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal"
    >1</j.0:displayOrder>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#MeasuredParameter"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#hasAvailabilityWindow">
    <rdfs:comment>Expected product/service availability period (e.g., “Mon–Fri 08:00–18:00”)</rdfs:comment>
