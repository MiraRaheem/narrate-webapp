      <rdfs:Datatype>
        <owl:oneOf>
          <rdf:List>
            <rdf:rest>
              <rdf:List>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                <rdf:first>yes</rdf:first>
              </rdf:List>
            </rdf:rest>
            <rdf:first>no</rdf:first>
          </rdf:List>
        </owl:oneOf>
      </rdfs:Datatype>
    </rdfs:range>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#ProcessSustainability"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#targetValue">
    <rdfs:comment>The agreed quantitative performance value or threshold</rdfs:comment>
    <rdfs:comment>Represents the desired or expected value of the productionMetric under normal operating conditions. It serves as a benchmark for evaluating production performance.</rdfs:comment>
