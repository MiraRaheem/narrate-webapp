    <rdfs:comment>e.g., “ISO 9001:2015”, “EN 71-3 compliant”. Can be used for ISO/QA compliance across SLA types.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#SLAStipulation"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#hasWorkOrderNote">
    <rdfs:comment>Optional notes, comments, or exceptions</rdfs:comment>
    <j.0:displayOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal"
    >5</j.0:displayOrder>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#WorkOrder"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#hasTemperatureCelsius">
    <rdfs:comment>If the warehouse has environmental tracking (optional)</rdfs:comment>
    <j.0:displayOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal"
    >7</j.0:displayOrder>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#Warehousing"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#strategyType">
    <rdfs:comment>Classifies the approach used to mitigate a disruption. Allowed values: ImmediateResponse (urgent impact reduction); ContingencyPlan (predefined fallback approach); AlternativeWorkflow (alternative operational process); ResourceReallocation (redistribution of available resources); SupplierSubstitution (replacement of an affected supplier); ProcessReconfiguration (modification of production or logistics processes); MaintenanceAction (repair or servicing intervention); Other (approach outside the defined categories).</rdfs:comment>
    <rdfs:range>
      <rdfs:Datatype>
        <owl:oneOf>
          <rdf:List>
            <rdf:rest>
              <rdf:List>
                <rdf:rest>
                  <rdf:List>
                    <rdf:rest>
                      <rdf:List>
                        <rdf:rest>
                          <rdf:List>
                            <rdf:rest>
                              <rdf:List>
                                <rdf:rest>
                                  <rdf:List>
                                    <rdf:rest>
                                      <rdf:List>
                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                        <rdf:first>SupplierSubstitution</rdf:first>
                                      </rdf:List>
                                    </rdf:rest>
                                    <rdf:first>ResourceReallocation</rdf:first>
                                  </rdf:List>
                                </rdf:rest>
                                <rdf:first>ProcessReconfiguration</rdf:first>
                              </rdf:List>
                            </rdf:rest>
                            <rdf:first>Other</rdf:first>
                          </rdf:List>
                        </rdf:rest>
                        <rdf:first>MaintenanceAction</rdf:first>
                      </rdf:List>
                    </rdf:rest>
                    <rdf:first>ImmediateResponse</rdf:first>
                  </rdf:List>
                </rdf:rest>
                <rdf:first>ContingencyPlan</rdf:first>
              </rdf:List>
            </rdf:rest>
            <rdf:first>AlternativeWorkflow</rdf:first>
          </rdf:List>
        </owl:oneOf>
      </rdfs:Datatype>
    </rdfs:range>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#MitigationStrategy"/>
  </owl:DatatypeProperty>
