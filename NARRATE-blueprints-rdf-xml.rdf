  <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#hasRenewableEnergyShare">
    <rdfs:comment>% renewable energy sourced</rdfs:comment>
    <rdfs:comment>% of supplier’s energy sourced from renewables.</rdfs:comment>
