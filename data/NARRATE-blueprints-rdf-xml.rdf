        <hasProductionPlanSustainability rdf:resource="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#ProcessSustainability_CotPlan_1"/>
        <organizesProcess rdf:resource="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#AssemblyStageProcess_1"/>
        <organizesProcess rdf:resource="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#CuttingStageProcess_1"/>
        <organizesProcess rdf:resource="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#FinishingStageProcess_1"/>
        <organizesWordOrder rdf:resource="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#CotWorkOrder_1"/>
        <reservesMachine rdf:resource="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#MACH-001"/>
        <reservesMachine rdf:resource="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#MACH-002"/>
        <reservesMachine rdf:resource="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#MACH-003"/>
        <usesMBOM rdf:resource="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#MBOM_BespokeCot_SiteA_001"/>
        <WaterUsage rdf:datatype="http://www.w3.org/2001/XMLSchema#float">500.0</WaterUsage>
        <expectedCO2Emissions rdf:datatype="http://www.w3.org/2001/XMLSchema#float">220.0</expectedCO2Emissions>
        <expectedEnergyConsumption rdf:datatype="http://www.w3.org/2001/XMLSchema#float">1550.0</expectedEnergyConsumption>
        <materialWaste rdf:datatype="http://www.w3.org/2001/XMLSchema#float">3.0</materialWaste>
        <plannedCycleTime rdf:datatype="http://www.w3.org/2001/XMLSchema#int">72</plannedCycleTime>
        <plannedEndDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-05-15T00:00:00</plannedEndDate>
        <plannedProductionQuantity rdf:datatype="http://www.w3.org/2001/XMLSchema#int">100</plannedProductionQuantity>
        <plannedStartDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-05-10T00:00:00</plannedStartDate>
        <processInstruction>Step1: Request SupplierA.material IF inventoryCheck(Wood) &lt;10</processInstruction>
        <processInstruction>Step2: Request SupplierB.material IF inventoryCheck(Fasteners) &lt;50</processInstruction>
        <processInstruction>Step3: SupplierC.material IF inventory_check(Fabric) &lt; 20</processInstruction>
        <processInstruction>Step4: EXECUTE CuttingStage</processInstruction>
        <processInstruction>Step5: EXECUTE AssemblyStage AFTER CuttingStage</processInstruction>
        <processInstruction>Step6: EXECUTE FinishingStage AFTER AssemblyStage</processInstruction>
        <processInstruction>Step7: SCHEDULE DELIVERY customer_id=</processInstruction>
        <renewableEnergyShare rdf:datatype="http://www.w3.org/2001/XMLSchema#float">40.0</renewableEnergyShare>
        <resourceUtilization rdf:datatype="http://www.w3.org/2001/XMLSchema#float">85.0</resourceUtilization>
        <sustainabilityRating>low impact</sustainabilityRating>
    </owl:NamedIndividual>
    


