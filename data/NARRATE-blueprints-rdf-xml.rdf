        <j.0:blueprintClass>EventBlueprint</j.0:blueprintClass>
        <rdfs:comment>SensorObservationEvent is a specialization of ObservationEvent representing events generated from sensor-based observations.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#Shipment -->

