        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <displayOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2</displayOrder>
        <rdfs:comment>Date and time when the MBOM was created.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#hasCustomerEmail -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/amal.elgammal/ontologies/2025/3/untitled-ontology-31#hasCustomerEmail">
